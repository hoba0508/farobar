<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Website Form View Inherited -->
	<record id="view_website_form_inherit_meta_pixel_code" model="ir.ui.view">
		<field name="name">website.form.inherit.meta.pixel</field>
		<field name="model">website</field>
		<field name="inherit_id" ref="website.view_website_form"/>
		<field name="arch" type="xml">
			<xpath expr="//notebook" position="inside">
				<page string="Meta Pixel Code" name="meta_pixel_code">
                    <field name="meta_pixel_code" widget="code"/>
                </page>
			</xpath>
		</field>
	</record>
</odoo>
